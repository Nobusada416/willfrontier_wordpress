{
  "name": "@wf/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "postbuild": "node scripts/create-404.mjs && node scripts/verify-prerender.mjs",
    "preview": "vite preview --outDir build/client",
    "typecheck": "react-router typegen && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "media:manifest": "node --experimental-strip-types --no-warnings scripts/generate-media-manifest.ts"
  },
  "devDependencies": {
    "@react-router/dev": "~7.18.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "image-size": "^2.0.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-router/node": "~7.18.4",
    "gsap": "^3.15.0",
    "isbot": "^5.2.2",
    "lenis": "^1.3.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "~7.18.4"
  }
}
