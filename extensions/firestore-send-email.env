# Trigger Email 拡張（firebase/firestore-send-email）の設定。
# firebase.json の "extensions" にバージョンを固定して登録している。詳細は docs/forms.md の「メール」。
#
# SMTP の接続文字列とパスワードはここに書かない。
# - SMTP_CONNECTION_URI: ユーザー名・ホストを含むため、導入時の入力で設定する（Secret と同じ扱い）
# - SMTP_PASSWORD: Secret Manager に保存される（type: secret）。導入時の入力で設定する

# Firestore（既定のデータベース・東京リージョン。本番 willfrontier-hp も asia-northeast1）
DATABASE=(default)
DATABASE_REGION=asia-northeast1

# SMTP の認証方式（ユーザー名とパスワード）
AUTH_TYPE=UsernamePassword

# Cloud Functions（submitInquiry）が書き込むメール送信キュー
MAIL_COLLECTION=mail

# 差出人。Google Workspace の SMTP（smtp.gmail.com）で認証するアカウントと同じアドレスにする
# （Gmail の SMTP は差出人を認証したアカウントに書き換えるため）
DEFAULT_FROM=ウィルフロンティア <info@willfrontier.jp>

# 拡張の TTL（delivery.expireAt）は使わない。
# submitInquiry が mail ドキュメントの最上位に expireAt を書き、Firestore の TTL ポリシーで削除する
TTL_EXPIRE_TYPE=never
TTL_EXPIRE_VALUE=1

# 拡張の関数（processQueue）を東京で動かす（既定の us-central1 だと、個人情報を含む mail が米国で処理される）
firebaseextensions.v1beta.function/location=asia-northeast1
